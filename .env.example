# Copy file nay thanh ".env" (cung cap goc repo) neu muon override cau hinh
# ma khong sua config/default.yaml hoac dat bien moi truong that.
#
# Thu tu uu tien (cao -> thap):
#   init kwargs (code) > bien moi truong that > file .env > config/default.yaml
#
# Tat ca bien deu co prefix LOCAL_AI_GATEWAY_, cac truong long nhau noi
# bang "__" (double underscore).

# --- Chon file config khac (thay vi config/default.yaml, config/budgets.yaml) ---
# LOCAL_AI_GATEWAY_CONFIG=D:\path\to\custom-default.yaml
# LOCAL_AI_GATEWAY_BUDGETS_CONFIG=D:\path\to\custom-budgets.yaml

# --- Provider ---
# LOCAL_AI_GATEWAY_PROVIDER=ollama

# --- Ollama ---
# LOCAL_AI_GATEWAY_OLLAMA__ENDPOINT=http://localhost:11434
# LOCAL_AI_GATEWAY_OLLAMA__MODEL=qwen3.5:9b

# --- Timeout / retry ---
# LOCAL_AI_GATEWAY_TIMEOUT_SECONDS=60
# LOCAL_AI_GATEWAY_RETRY__MAX_ATTEMPTS=3
# LOCAL_AI_GATEWAY_RETRY__BACKOFF_BASE_SECONDS=0.5

# --- Concurrency (giam neu tran VRAM, tang neu con du) ---
# LOCAL_AI_GATEWAY_CONCURRENCY__MAX_PARALLEL_REQUESTS=1

# --- Logging ---
# LOCAL_AI_GATEWAY_LOGGING__LEVEL=INFO
# Chi bat true khi dev/debug local - se ghi ca noi dung task/context/response.
# LOCAL_AI_GATEWAY_LOGGING__DEBUG_LOG_CONTENT=false
