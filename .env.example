# Copy this file to ".env" (in the repository root) to override configurations
# without modifying config/default.yaml or setting system environment variables.
#
# Priority (highest to lowest):
#   init kwargs (code) > real environment variables > .env file > config/default.yaml
#
# All variables must have the LOCAL_AI_GATEWAY_ prefix. Nested fields are
# separated by "__" (double underscore).

# --- Select alternative config files (instead of config/default.yaml, config/budgets.yaml) ---
# LOCAL_AI_GATEWAY_CONFIG=D:\path\to\custom-default.yaml
# LOCAL_AI_GATEWAY_BUDGETS_CONFIG=D:\path\to\custom-budgets.yaml

# --- Providers ---
# The default provider used when call_local does not specify a provider.
# LOCAL_AI_GATEWAY_DEFAULT_PROVIDER=ollama
#
# The list of providers (dict) is defined in config/default.yaml.
# Providers of type "openai_compatible" (e.g., Gemini) require a real API key.
# This key is read from the environment variable specified by the "api_key_env"
# field in default.yaml (default is GEMINI_API_KEY for the built-in "gemini" provider).
# If this variable is not set, the provider is SKIPPED (with a warning in the logs),
# but other providers (like ollama) will continue to function normally.
# GEMINI_API_KEY=your-real-gemini-api-key-here

# --- Timeout / retry ---
# LOCAL_AI_GATEWAY_TIMEOUT_SECONDS=60
# LOCAL_AI_GATEWAY_RETRY__MAX_ATTEMPTS=3
# LOCAL_AI_GATEWAY_RETRY__BACKOFF_BASE_SECONDS=0.5

# --- Concurrency (decrease if OOM, increase if you have spare VRAM) ---
# LOCAL_AI_GATEWAY_CONCURRENCY__MAX_PARALLEL_REQUESTS=1

# --- Logging ---
# LOCAL_AI_GATEWAY_LOGGING__LEVEL=INFO
# Enable only for local dev/debug - logs the full content of tasks/contexts/responses.
# LOCAL_AI_GATEWAY_LOGGING__DEBUG_LOG_CONTENT=false

# --- File access (call_local file_paths) ---
# Empty list = direct file reading feature is DISABLED. The value must be a JSON array:
# e.g., ["D:\\project\\mcp", "D:\\project\\other-repo"]
# LOCAL_AI_GATEWAY_FILE_ACCESS__ALLOWED_ROOTS=[]
# LOCAL_AI_GATEWAY_FILE_ACCESS__MAX_FILE_BYTES=200000
# LOCAL_AI_GATEWAY_FILE_ACCESS__MAX_TOTAL_BYTES=800000

# --- Response caching (by final prompt + options) ---
# LOCAL_AI_GATEWAY_CACHE__ENABLED=true
# LOCAL_AI_GATEWAY_CACHE__MAX_ENTRIES=256
# LOCAL_AI_GATEWAY_CACHE__TTL_SECONDS=3600

# --- Background jobs (call_local async_mode=true / check_job_status) ---
# LOCAL_AI_GATEWAY_JOBS__TTL_SECONDS=3600
# LOCAL_AI_GATEWAY_JOBS__MAX_ENTRIES=1000

# --- Local RAG (file_paths pointing to a directory) ---
# Disabled by default. Requires a separate embedding model pulled in Ollama
# (e.g., "ollama pull nomic-embed-text").
# LOCAL_AI_GATEWAY_RAG__ENABLED=false
# LOCAL_AI_GATEWAY_RAG__EMBEDDING_MODEL=nomic-embed-text
# LOCAL_AI_GATEWAY_RAG__CHUNK_SIZE_TOKENS=256
# LOCAL_AI_GATEWAY_RAG__OVERLAP_TOKENS=32
# LOCAL_AI_GATEWAY_RAG__TOP_K=10
