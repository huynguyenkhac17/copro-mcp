# Copy this file to ~/.copro/.env (installed tool) or to ".env" at the
# repository root (source checkout) to override configuration without editing the
# shipped default.yaml or setting system environment variables.
#
# Priority (highest to lowest):
#   init kwargs (code) > real environment variables > repo .env
#   > ~/.copro/.env > default.yaml
#
# All variables must have the COPRO_ prefix. Nested fields are
# separated by "__" (double underscore).

# --- Select alternative config files (instead of the shipped YAML defaults) ---
# COPRO_CONFIG=/path/to/custom-default.yaml
# COPRO_BUDGETS_CONFIG=/path/to/custom-budgets.yaml
# COPRO_TASK_PROFILES_CONFIG=/path/to/custom-task_profiles.yaml

# --- Providers ---
# The default provider used when delegate_task does not specify a provider.
# The shipped default is gemini-lite; budgets L1-L3 route to groq first (budget_providers).
# COPRO_DEFAULT_PROVIDER=gemini-lite
#
# The list of providers (dict) is defined in default.yaml.
# Providers of type "openai_compatible" (e.g., Gemini) require a real API key.
# These keys are read from the environment variable name(s) specified by the
# "api_key_env" (single) and/or "api_key_envs" (list, round-robin) fields in
# default.yaml (default is GEMINI_API_KEY for the built-in "gemini" provider).
# Unlike other COPRO_* settings, these variable NAMES are arbitrary
# (whatever you put in default.yaml) - but setting them here in .env works
# too: this file is loaded via python-dotenv into the real process environment
# at startup (not just into pydantic's settings object), so it behaves exactly
# like exporting them as real OS environment variables. A real OS env var of
# the same name still takes priority over the value here.
# If none of the configured variables are set, the provider is SKIPPED (with a
# warning in the logs), but other providers (like ollama) continue to work.
# GROQ_API_KEY=your-groq-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# MISTRAL_API_KEY=your-mistral-api-key-here
# DeepSeek is paid (cheap); the chains use it only after the free tiers.
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# Extra keys are optional: GEMINI_API_KEY_2 .. _9, GROQ_API_KEY_1 .. _4,
# MISTRAL_API_KEY_2.
# GEMINI_API_KEY_2=a-key-from-another-google-cloud-project

# --- Timeout / retry ---
# COPRO_TIMEOUT_SECONDS=60
# COPRO_RETRY__MAX_ATTEMPTS=3
# COPRO_RETRY__BACKOFF_BASE_SECONDS=0.5

# --- Logging ---
# COPRO_LOGGING__LEVEL=INFO
# Enable only for local dev/debug - logs the full content of tasks/contexts/responses.
# COPRO_LOGGING__DEBUG_LOG_CONTENT=false

# --- File access (delegate_task file_paths) ---
# Empty list (the shipped default) = direct file reading is DISABLED. The value
# must be a JSON array, e.g. ["/home/me/projects"] or ["D:/projects", "E:/work"]
# COPRO_FILE_ACCESS__ALLOWED_ROOTS=[]
# COPRO_FILE_ACCESS__MAX_FILE_BYTES=200000
# COPRO_FILE_ACCESS__MAX_TOTAL_BYTES=800000

# --- Response caching (by final prompt + options) ---
# COPRO_CACHE__ENABLED=true
# COPRO_CACHE__MAX_ENTRIES=256
# COPRO_CACHE__TTL_SECONDS=3600

# --- Background jobs (delegate_task async_mode=true / check_job_status) ---
# COPRO_JOBS__TTL_SECONDS=3600
# COPRO_JOBS__MAX_ENTRIES=1000

# --- Local RAG (file_paths pointing to a directory) ---
# Disabled by default. Requires a separate embedding model pulled in Ollama
# (e.g., "ollama pull nomic-embed-text").
# COPRO_RAG__ENABLED=false
# COPRO_RAG__EMBEDDING_MODEL=nomic-embed-text
# COPRO_RAG__CHUNK_SIZE_TOKENS=256
# COPRO_RAG__OVERLAP_TOKENS=32
# COPRO_RAG__TOP_K=10
