# Copy this file to ".env" (in the repository root) to override configurations
# without modifying config/default.yaml or setting system environment variables.
#
# Priority (highest to lowest):
#   init kwargs (code) > real environment variables > .env file > config/default.yaml
#
# All variables must have the LLM_WORKER_POOL_ prefix. Nested fields are
# separated by "__" (double underscore).

# --- Select alternative config files (instead of config/default.yaml, config/budgets.yaml) ---
# LLM_WORKER_POOL_CONFIG=D:\path\to\custom-default.yaml
# LLM_WORKER_POOL_BUDGETS_CONFIG=D:\path\to\custom-budgets.yaml

# --- Providers ---
# The default provider used when delegate_task does not specify a provider.
# LLM_WORKER_POOL_DEFAULT_PROVIDER=ollama
#
# The list of providers (dict) is defined in config/default.yaml.
# Providers of type "openai_compatible" (e.g., Gemini) require a real API key.
# These keys are read from the environment variable name(s) specified by the
# "api_key_env" (single) and/or "api_key_envs" (list, round-robin) fields in
# default.yaml (default is GEMINI_API_KEY for the built-in "gemini" provider).
# Unlike other LLM_WORKER_POOL_* settings, these variable NAMES are arbitrary
# (whatever you put in default.yaml) - but setting them here in .env works
# too: this file is loaded via python-dotenv into the real process environment
# at startup (not just into pydantic's settings object), so it behaves exactly
# like exporting them as real OS environment variables. A real OS env var of
# the same name still takes priority over the value here.
# If none of the configured variables are set, the provider is SKIPPED (with a
# warning in the logs), but other providers (like ollama) continue to work.
# GEMINI_API_KEY=your-real-gemini-api-key-here
# GEMINI_API_KEY_1=your-second-gemini-api-key-here
# GEMINI_API_KEY_2=your-third-gemini-api-key-here

# --- Timeout / retry ---
# LLM_WORKER_POOL_TIMEOUT_SECONDS=60
# LLM_WORKER_POOL_RETRY__MAX_ATTEMPTS=3
# LLM_WORKER_POOL_RETRY__BACKOFF_BASE_SECONDS=0.5

# --- Logging ---
# LLM_WORKER_POOL_LOGGING__LEVEL=INFO
# Enable only for local dev/debug - logs the full content of tasks/contexts/responses.
# LLM_WORKER_POOL_LOGGING__DEBUG_LOG_CONTENT=false

# --- File access (delegate_task file_paths) ---
# Empty list = direct file reading feature is DISABLED. The value must be a JSON array:
# e.g., ["D:\\project\\mcp", "D:\\project\\other-repo"]
# LLM_WORKER_POOL_FILE_ACCESS__ALLOWED_ROOTS=[]
# LLM_WORKER_POOL_FILE_ACCESS__MAX_FILE_BYTES=200000
# LLM_WORKER_POOL_FILE_ACCESS__MAX_TOTAL_BYTES=800000

# --- Response caching (by final prompt + options) ---
# LLM_WORKER_POOL_CACHE__ENABLED=true
# LLM_WORKER_POOL_CACHE__MAX_ENTRIES=256
# LLM_WORKER_POOL_CACHE__TTL_SECONDS=3600

# --- Background jobs (delegate_task async_mode=true / check_job_status) ---
# LLM_WORKER_POOL_JOBS__TTL_SECONDS=3600
# LLM_WORKER_POOL_JOBS__MAX_ENTRIES=1000

# --- Local RAG (file_paths pointing to a directory) ---
# Disabled by default. Requires a separate embedding model pulled in Ollama
# (e.g., "ollama pull nomic-embed-text").
# LLM_WORKER_POOL_RAG__ENABLED=false
# LLM_WORKER_POOL_RAG__EMBEDDING_MODEL=nomic-embed-text
# LLM_WORKER_POOL_RAG__CHUNK_SIZE_TOKENS=256
# LLM_WORKER_POOL_RAG__OVERLAP_TOKENS=32
# LLM_WORKER_POOL_RAG__TOP_K=10
